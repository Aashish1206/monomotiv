# ==============================================================================
# MONOMOTIV ENVIRONMENT VARIABLES
# ==============================================================================

# MongoDB Atlas Cloud Connection String
# In Vercel Project Settings > Environment Variables, add:
# Key: MONGODB_URI
# Value: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/monomotiv?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abc.mongodb.net/monomotiv?retryWrites=true&w=majority

# Local fallback (for offline local development):
# MONGODB_URI=mongodb://127.0.0.1:27017/monomotiv

# Optional Port for standalone local server (default: 3000)
PORT=3000
